generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("Client") // Admin | Client | Guest
  status    String   @default("Active") // Active | Pending | Inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  category    String
  price       Float?
  imageUrl    String?
  features    String?  // JSON string
  specs       String?  // JSON string
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  imageUrl    String?
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ad {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  linkUrl     String?
  position    String   @default("banner") // banner | sidebar | popup
  isActive    Boolean  @default(true)
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Career {
  id           String   @id @default(cuid())
  title        String
  department   String
  location     String
  type         String   @default("Full-time") // Full-time | Part-time | Contract
  description  String
  requirements String?
  isOpen       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  applications JobApplication[]
}

// An application submitted from the public Careers page form. The applicant's
// details are stored as fields; an optional CV lives on disk in CV_DIR (private —
// never served from /uploads) in compressed form, and only admins can fetch it
// back through /api/applications/:id/cv.
model JobApplication {
  id                String   @id @default(cuid())
  careerId          String?
  career            Career?  @relation(fields: [careerId], references: [id], onDelete: SetNull)
  jobTitle          String   // snapshot of the role title (or "General application")

  // Personal
  fullName          String
  email             String
  phone             String
  location          String   // current town / county
  linkedinUrl       String?

  // Education — full history as JSON: [{ level, institution, course, yearFrom, yearTo }]
  // (high school is always the first entry). The columns below summarise the
  // highest qualification for listing/filtering.
  educationHistory  String?
  educationLevel    String?  // highest: High School | Certificate | Diploma | Bachelor's | Master's | PhD
  fieldOfStudy      String?
  institution       String?
  graduationYear    Int?

  // Experience — full history as JSON: [{ title, employer, from, to, current, duties }]
  // (most recent first); currentTitle/currentEmployer summarise the latest role.
  workHistory       String?
  yearsExperience   String   // e.g. "0-1", "1-3", "3-5", "5-10", "10+"
  currentTitle      String?
  currentEmployer   String?
  experienceSummary String?
  skills            String
  certifications    String?

  // Availability
  availability      String   // Immediately | 2 weeks | 1 month | 2+ months
  expectedSalary    String?
  willingToTravel   Boolean  @default(false)

  message           String?  // why they want the role / cover note
  consent           Boolean  @default(false)

  // Optional CV attachment
  cvFileName        String?  // original filename as uploaded
  cvStoredName      String?  // filename on disk inside CV_DIR
  cvMimeType        String?  // mime type of the document as served back
  cvGzipped         Boolean  @default(false) // stored gzip-compressed at rest
  originalSize      Int?
  storedSize        Int?

  status            String   @default("New") // New | Reviewed | Shortlisted | Rejected
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
